rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio global content document (publicly accessible)
    match /portfolio_content/{docId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Portfolio individual projects collection (publicly accessible)
    match /portfolio_projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
